# Copy to .env; do NOT commit real credentials.
# API boots in demo mode without keys. Source refresh is opt-in.
AGENT_PROVIDER=demo
# Agent provider: demo | google | groq | auto
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Advanced mode is opt-in; your project may have a much smaller daily quota.
GEMINI_ADVANCED_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Street routing on by default for this NONCOMMERCIAL demonstration.
# Public OSRM is rate-limited (1 request/sec) and has no uptime promise; self-host for production.
ROUTING_PROVIDER=osrm_demo
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org
SOURCE_REFRESH_MIN_SECONDS=240
CORS_ORIGINS=http://localhost:3000
# v1.1: real streets, OPTIONAL. Requires network access; no LLM/GPU.
# Choose `osrm_demo` for responsible non-commercial testing (max 1 request/sec, no SLA).
# Use `ors` with ORS_API_KEY for a personal HeiGIT Standard account.
OSRM_BASE_URL=https://router.project-osrm.org

# v1.3 Road matrix optimizer: fail closed if Table costs are unavailable.
ROAD_MATRIX_OPTIMIZATION=true
